# Copy this file to .env and fill in the key for the provider you use.

# Which provider: groq | openrouter | nvidia | ollama (local, no key needed)
PROVIDER=groq

# Which model. Leave it commented out to use the provider's default.
# MODEL=openai/gpt-oss-120b

# Permissions: ask | auto | read-only
MODE=ask

# Context: past this many tokens, everything but the last KEEP_TURNS tasks is summarised.
# Set CONTEXT_TOKENS=2000 to watch compaction happen in a demo.
CONTEXT_TOKENS=16000
KEEP_TURNS=3

GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
